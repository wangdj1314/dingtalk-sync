_viewer/files_index.json
_viewer/image_index.json
_viewer/calendar_index.json
_viewer/schedule_index.json
_viewer/todo_index.json
_viewer/minutes_index.json

# === 打包构建产物 ===
packaging/build/
packaging/dist/
packaging/Output/

# === 配置文件（含个人信息，用 example 替代）===
